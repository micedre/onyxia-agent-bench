{
  "small_model": "onyxia/gemma4-26b-moe",
  "default_agent": "build",
  "tool_output": { "max_lines": 200, "max_bytes": 20000 },
  "compaction": { "auto": true, "prune": true, "tail_turns": 4 },
  "experimental": { "continue_loop_on_deny": true },
  "permission": {
    "webfetch": "ask",
    "task": { "*": "allow", "general": "deny" },
    "skill": { "*": "allow" },
    "bash": {
      "*": "ask",
      "git *": "allow",
      "uv *": "allow",
      "pip *": "allow",
      "pixi *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "pytest*": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "Rscript *": "allow",
      "R -e *": "allow",
      "quarto *": "allow",
      "make *": "allow",
      "just *": "allow",
      "mc *": "allow",
      "aws s3*": "allow",
      "mlflow *": "allow",
      "duckdb *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "mkdir *": "allow",
      "echo *": "allow",
      "cd *": "allow",
      "which *": "allow",
      "pwd*": "allow",
      "vault kv get*": "allow",
      "vault kv list*": "allow",
      "argo list*": "allow",
      "argo get*": "allow",
      "argo logs*": "allow",
      "argo watch*": "allow",
      "kubectl get*": "allow",
      "kubectl describe*": "allow",
      "kubectl logs*": "allow",
      "kubectl top*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "argo submit*": "ask",
      "argo delete*": "ask",
      "kubectl apply*": "ask",
      "kubectl create*": "ask",
      "kubectl delete*": "ask",
      "docker *": "ask",
      "aws s3 rm*": "ask",
      "aws s3 sync*": "ask",
      "mc rm*": "ask",
      "rm *": "ask",
      "curl *": "ask",
      "wget *": "ask"
    }
  },
  "mcp": {},
  "agent": {
    "build": {
      "mode": "primary",
      "model": "onyxia/qwen3-6-35b-moe",
      "temperature": 0.2,
      "prompt": "{file:./.opencode/prompts/shared/base.md}\n\n{file:./.opencode/prompts/build.md}\n\n{file:./.opencode/prompts/shared/completion-contract.md}",
      "permission": { "edit": "allow" }
    },
    "plan": {
      "mode": "primary",
      "model": "onyxia/qwen3-6-35b-moe",
      "temperature": 0.6,
      "top_p": 0.95,
      "options": { "chat_template_kwargs": { "enable_thinking": true } },
      "prompt": "{file:./.opencode/prompts/shared/base.md}\n\n{file:./.opencode/prompts/plan.md}",
      "permission": {
        "edit": { "*": "deny", ".opencode/plans/*.md": "allow" },
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "ls *": "allow",
          "aws s3 ls*": "allow",
          "mc ls*": "allow",
          "duckdb *": "allow"
        }
      }
    },
    "python-ds": {
      "mode": "subagent",
      "description": "Python data science / ML specialist on Onyxia (uv, ruff, polars, pandas, scikit-learn, pyarrow, s3fs). Use to write or refactor Python code for analysis, modelling, or pipelines.",
      "model": "onyxia/qwen3-6-35b-moe",
      "temperature": 0.2,
      "prompt": "{file:./.opencode/prompts/shared/base.md}\n\n{file:./.opencode/prompts/python-ds.md}\n\n{file:./.opencode/prompts/shared/completion-contract.md}",
      "permission": { "edit": "allow" }
    },
    "r-ds": {
      "mode": "subagent",
      "description": "R data science specialist (tidyverse, data.table, targets, renv, testthat, aws.s3, arrow). Use for any R code for analysis, modelling, or reproducible pipelines.",
      "model": "onyxia/qwen3-6-35b-moe",
      "temperature": 0.2,
      "prompt": "{file:./.opencode/prompts/shared/base.md}\n\n{file:./.opencode/prompts/r-ds.md}\n\n{file:./.opencode/prompts/shared/completion-contract.md}",
      "permission": { "edit": "allow" }
    },
    "mlops": {
      "mode": "subagent",
      "description": "Onyxia MLOps engineer: MLflow experiment tracking, parallel training via Argo Workflows (argo submit, CronWorkflow), GitOps deployment via ArgoCD, model packaging and productionization. Use to industrialize/deploy a model or schedule recurring jobs.",
      "model": "onyxia/qwen3-6-35b-moe",
      "temperature": 0.2,
      "prompt": "{file:./.opencode/prompts/shared/base.md}\n\n{file:./.opencode/prompts/mlops.md}\n\n{file:./.opencode/prompts/shared/completion-contract.md}",
      "permission": { "edit": "allow" }
    },
    "reviewer": {
      "mode": "subagent",
      "description": "Fresh-context grader AND code reviewer (read-only). Give it the path to an acceptance file (usually .opencode/plans/<slug>.md) plus `git diff --stat`: it re-runs every check itself and returns PASS/FAIL per acceptance item (blocking), followed by quality/reproducibility/security findings (advisory). Invoke at the END of any task that changed a file, before telling the user it is done. Never edits, never commits, never deploys.",
      "model": "onyxia/gemma4-26b-moe",
      "temperature": 0,
      "steps": 40,
      "prompt": "{file:./.opencode/prompts/shared/base.md}\n\n{file:./.opencode/prompts/reviewer.md}",
      "permission": {
        "edit": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny",
        "bash": {
          "*": "deny",
          "ls *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "find *": "allow",
          "git status": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "uv run *": "allow",
          "uv sync*": "allow",
          "uv tree*": "allow",
          "python *": "allow",
          "python3 *": "allow",
          "pytest*": "allow",
          "ruff *": "allow",
          "mypy *": "allow",
          "Rscript *": "allow",
          "R -e *": "allow",
          "quarto render*": "allow",
          "quarto check*": "allow",
          "duckdb *": "allow",
          "mlflow *": "allow",
          "aws s3 ls*": "allow",
          "mc ls*": "allow",
          "make *": "allow",
          "just *": "allow",
          "git commit*": "deny",
          "git push*": "deny",
          "git checkout*": "deny",
          "git reset*": "deny",
          "git clean*": "deny",
          "rm *": "deny",
          "mv *": "deny",
          "aws s3 cp*": "deny",
          "aws s3 rm*": "deny",
          "aws s3 sync*": "deny",
          "mc cp*": "deny",
          "mc rm*": "deny",
          "argo submit*": "deny",
          "kubectl apply*": "deny",
          "kubectl delete*": "deny",
          "docker *": "deny",
          "pip install*": "deny",
          "uv add*": "deny"
        }
      }
    },
    "dataviz-vision": {
      "mode": "subagent",
      "description": "Visual analysis (vision model): reads screenshots, matplotlib/ggplot charts, architecture diagrams, or dashboards to interpret them or suggest improvements. Use whenever an image is provided.",
      "model": "onyxia/qwen3-vl",
      "temperature": 0.3,
      "prompt": "{file:./.opencode/prompts/dataviz-vision.md}",
      "permission": { "edit": "deny", "bash": "deny", "task": "deny", "webfetch": "deny" }
    }
  }
}
